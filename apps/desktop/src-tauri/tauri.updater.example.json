{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": { "createUpdaterArtifacts": true },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_TAURI_PUBLIC_VERIFICATION_KEY",
