{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexa Office",
  "version": "0.1.0",
  "identifier": "app.nexa.office",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexa Office",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f7f8f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_LICENSES.md": "licenses/THIRD_PARTY_LICENSES.md",
      "../../../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    },
    "targets": ["deb", "appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Your work, at home on your desktop.",
    "longDescription": "An offline office suite with Writer, Sheets and Slides, durable native formats and local Office interoperability.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["nxd"],
        "mimeType": "application/vnd.nexa.document",
        "description": "Nexa Document",
        "role": "Editor"
      },
      {
        "ext": ["nxs"],
        "mimeType": "application/vnd.nexa.spreadsheet",
        "description": "Nexa Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": ["nxp"],
        "mimeType": "application/vnd.nexa.presentation",
        "description": "Nexa Presentation",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../../../public/nexa-office.desktop",
        "files": {
          "/usr/share/mime/packages/nexa-office.xml": "../../../public/nexa-office.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/nexa-office.xml": "../../../public/nexa-office.xml",
          "/usr/share/applications/Nexa Office.desktop": "../../../public/nexa-office.desktop"
        }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "Spanish", "Catalan"]
      }
    }
  }
}
